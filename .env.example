# All optional. Copy to .env (or export) only to override defaults.

# Root for frozen datasets, the probe set, and the download cache.
# Default: <repo>/data
HALLMARK_DATA_DIR=

# SQLite ledger used when calling hallmark.ledger.connect() without a path.
# Default: $HALLMARK_DATA_DIR/hallmark.db
HALLMARK_DB=

# Only needed for: python scripts/run_proposer.py --provider anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
HALLMARK_LLM_MODEL=claude-opus-5-5
